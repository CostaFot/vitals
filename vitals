def cmd_check(args: argparse.Namespace) -> int:
    snap = probe()
    record_sample(snap)
    record_readings(snap)
    record_smart(snap)
    alerts = checks(snap)
    dispatch(alerts, quiet=args.quiet)
    for alert in alerts:
        print(f"[{alert.severity}] {alert.title}: {alert.body}")
    return 1 if any(a.severity == "crit" for a in alerts) else 0


def cmd_probe(args: argparse.Namespace) -> int:
    print(json.dumps(probe(), indent=2, default=str))
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    snap = probe()
    cpu = snap["sensors"].get("cpu", {})
    gpu = snap.get("gpu") or {}

    print(f"load   {snap['load1']:.2f}")
    readings = "  ".join(
        f"{label} {value:.1f}C" for label, value in sorted(cpu.items())
    )
    print(f"cpu    {readings}" if readings else "cpu    unavailable")

    floor, count = idle_floor()
    if floor is None:
        print(f"       idle floor: not enough idle samples yet ({count}/"
              f"{CONFIG['idle_min_samples']})")
    else:
        verdict = "OK" if floor <= CONFIG["idle_floor_warn"] else "HIGH"
        print(f"       idle floor: Tccd2 median {floor:.1f}C over {count} "
              f"samples, limit {CONFIG['idle_floor_warn']:.0f}C [{verdict}]")

    if gpu:
        print(f"gpu    {gpu['name']}  {gpu['temp']:.0f}C  fan {gpu['fan']:.0f}%  "
              f"{gpu['power']:.0f}W  {gpu['mem_used']:.0f}/{gpu['mem_total']:.0f} MiB")

    for chip, drive in snap["sensors"].get("drives", {}).items():
        temps = "  ".join(f"{k} {v:.1f}C" for k, v in drive["temps"].items())
        limit = drive["limits"].get("Composite", {}).get("max")
        suffix = f"  (warn {limit:.0f}C)" if limit else ""
        print(f"drive  {drive['model']}: {temps}{suffix}")

    for path, usage in snap["disks"].items():
        print(f"disk   {path}  {usage['pct']:.0f}% used, "
              f"{usage['free'] / 1024**3:.1f}G free")

    root = snap.get("root") or {}
    if not root.get("drives"):
        print("smart  unavailable - the root timer is not installed "
              "(see install.sh)")
    else:
        age = root.get("age_hours", 0)
        for dev, drive in root["drives"].items():
            print(f"smart  {drive.get('model', dev)}: {drive.get('health')}, "
                  f"{drive.get('percentage_used')}% used, "
                  f"spare {drive.get('available_spare')}%, "
                  f"{drive.get('media_errors')} media errors, "
                  f"{drive.get('unsafe_shutdowns')} unsafe shutdowns")
        print(f"       (read {age:.1f}h ago)")

    state = {k: v for k, v in load_alert_state().items() if not k.startswith("_")}
    if state:
        print("\nfiring:")
        for key, entry in state.items():
            age = (time.time() - entry.get("since", 0)) / 3600
            print(f"  [{entry['severity']}] {entry['title']} - {entry['body']} "
                  f"({age:.1f}h)")
    else:
        print("\nnothing firing")
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    if not ALERT_LOG.exists():
        print("no alerts recorded")
        return 0
    lines = ALERT_LOG.read_text().splitlines()[-args.n:]
    for line in lines:
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(entry["ts"]))
        mark = "FIRE" if entry["kind"] == "fire" else "CLEAR"
        print(f"{when}  {mark:5} [{entry['severity']}] {entry['title']}: "
              f"{entry['body']}")
    return 0


def cmd_root_probe(args: argparse.Namespace) -> int:
    """Root-only facts, written where the user timer can read them."""
    if os.geteuid() != 0:
        print("vitals root-probe must run as root", file=sys.stderr)
        return 2

    drives = {}
    for dev in sorted(Path("/dev").glob("nvme[0-9]n1")):
        raw = run(["smartctl", "-j", "-a", str(dev)], timeout=30)
        if not raw:
            continue
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            continue
        log = data.get("nvme_smart_health_information_log", {})
        drives[str(dev)] = {
            "model": data.get("model_name"),
            "serial_present": bool(data.get("serial_number")),
            "health": "PASSED" if data.get("smart_status", {}).get("passed") else "FAILED",
            "critical_warning": log.get("critical_warning"),
            "temperature": log.get("temperature"),
            "available_spare": log.get("available_spare"),
            "available_spare_threshold": log.get("available_spare_threshold"),
            "percentage_used": log.get("percentage_used"),
            "media_errors": log.get("media_errors"),
            "unsafe_shutdowns": log.get("unsafe_shutdowns"),
            "power_cycles": log.get("power_cycles"),
            "power_on_hours": log.get("power_on_hours"),
        }

    facts = {"ts": time.time(), "drives": drives}

    snapshots = run(["snapper", "--machine-readable", "json", "list"], timeout=30)
    if snapshots:
        try:
            parsed = json.loads(snapshots)
            facts["snapshots"] = {
                config: len(entries) for config, entries in parsed.items()
            }
        except json.JSONDecodeError:
            pass

    ROOT_FACTS.parent.mkdir(parents=True, exist_ok=True)
    tmp = ROOT_FACTS.with_suffix(".tmp")
    tmp.write_text(json.dumps(facts, indent=2))
    tmp.chmod(0o644)
    tmp.replace(ROOT_FACTS)
    print(f"wrote {ROOT_FACTS} ({len(drives)} drive(s))")
    return 0


def summarise(values: list[float]) -> dict | None:
    if not values:
        return None
    ordered = sorted(values)
    return {
        "min": ordered[0],
        "median": median(ordered),
        "p95": ordered[min(len(ordered) - 1, int(len(ordered) * 0.95))],
        "max": ordered[-1],
        "n": len(ordered),
    }


SAMPLE_COLUMNS = (("load1", 1), ("tctl", 2), ("tccd1", 3),
                  ("tccd2", 4), ("gpu_temp", 5), ("gpu_fan", 6))


def report_data(hours: float) -> dict:
    """Everything the morning read needs, without handing over 1440 raw rows."""
    since = time.time() - hours * 3600
    data: dict = {"generated": time.time(), "since": since, "window_hours": hours}

    parsed: list[tuple[float, dict]] = []
    if SAMPLES.exists():
        for row in SAMPLES.read_text().splitlines()[1:]:
            parts = row.split(",")
            ts = _ts_of(row)
            if ts < since or len(parts) <= SAMPLE_COLUMNS[-1][1]:
                continue
            values = {}
            for name, idx in SAMPLE_COLUMNS:
                try:
                    values[name] = float(parts[idx])
                except ValueError:
                    pass
            parsed.append((ts, values))
    parsed.sort(key=lambda pair: pair[0])

    data["metrics"] = {
        name: summarise([v[name] for _, v in parsed if name in v])
        for name, _ in SAMPLE_COLUMNS
    }
    data["metrics"] = {k: v for k, v in data["metrics"].items() if v}

    # Gaps say the machine was asleep or the timer stopped, which changes how
    # the rest of the numbers should be read.
    gaps = [
        {"from": a, "to": b, "minutes": round((b - a) / 60)}
        for (a, _), (b, _) in zip(parsed, parsed[1:]) if b - a > 180
    ]
    data["coverage"] = {
        "samples": len(parsed), "expected": round(hours * 60), "gaps": gaps,
    }

    idle = [v["tccd2"] for _, v in parsed
            if "tccd2" in v and v.get("load1", 99) <= CONFIG["idle_load_max"]]
    data["idle_floor"] = {
        "median": median(idle) if idle else None,
        "samples": len(idle),
        "limit": CONFIG["idle_floor_warn"],
    }

    drives: dict = {}
    disks: dict = {}
    if READINGS.exists():
        for row in READINGS.read_text().splitlines()[1:]:
            parts = row.split(",")
            if len(parts) < 4 or _ts_of(row) < since:
                continue
            ts, metric, subject, raw = parts[0], parts[1], ",".join(parts[2:-1]), parts[-1]
            try:
                value = float(raw)
            except ValueError:
                continue
            if metric == "drive_temp":
                drives.setdefault(subject, []).append(value)
            elif metric in ("disk_pct", "disk_free_gb"):
                disks.setdefault(subject, {}).setdefault(metric, []).append(value)
    data["drive_temps"] = {k: summarise(v) for k, v in sorted(drives.items())}
    data["disks"] = {
        path: {
            "pct_start": series["disk_pct"][0], "pct_end": series["disk_pct"][-1],
            "free_gb_end": series.get("disk_free_gb", [None])[-1],
        }
        for path, series in sorted(disks.items()) if series.get("disk_pct")
    }

    # The drive's own limits are static hardware facts, and without them a
    # number like "Sensor 1 at 65C" cannot be judged.
    limits: dict = {}
    for drive in probe()["sensors"].get("drives", {}).values():
        for label, bounds in drive.get("limits", {}).items():
            limits[f"{drive['model']}/{label}"] = bounds
    data["drive_limits"] = limits

    smart = []
    if SMART_LOG.exists():
        for line in SMART_LOG.read_text().splitlines():
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if entry.get("ts", 0) >= since:
                smart.append(entry)
    counters = ("percentage_used", "media_errors", "unsafe_shutdowns",
                "power_on_hours", "available_spare")
    data["smart"] = {}
    if smart:
        first, last = smart[0].get("drives", {}), smart[-1].get("drives", {})
        for dev, end in sorted(last.items()):
            start = first.get(dev, {})
            data["smart"][dev] = {
                "model": end.get("model"), "health": end.get("health"),
                "critical_warning": end.get("critical_warning"),
                **{c: {"end": end.get(c), "delta": (end.get(c) or 0) - (start.get(c) or 0)}
                   for c in counters},
            }
        data["smart_probes"] = len(smart)

    alerts = []
    if ALERT_LOG.exists():
        for line in ALERT_LOG.read_text().splitlines():
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if entry.get("ts", 0) >= since:
                alerts.append(entry)
    data["alerts"] = alerts
    return data


def _clock(ts: float) -> str:
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts))


def render_report(data: dict) -> str:
    out = [f"vitals report  last {data['window_hours']:g}h  "
           f"({_clock(data['since'])} -> {_clock(data['generated'])})", ""]

    cov = data["coverage"]
    line = f"coverage  {cov['samples']}/{cov['expected']} samples"
    if cov["gaps"]:
        line += f", {len(cov['gaps'])} gap(s)"
    out.append(line)
    for gap in cov["gaps"]:
        out.append(f"          gap {_clock(gap['from'])} -> {_clock(gap['to'])} "
                   f"({gap['minutes']} min)")
    out.append("")

    for name, stat in data["metrics"].items():
        out.append(f"{name:9} min {stat['min']:6.1f}  median {stat['median']:6.1f}  "
                   f"p95 {stat['p95']:6.1f}  max {stat['max']:6.1f}")

    floor = data["idle_floor"]
    if floor["median"] is None:
        out.append(f"{'idlefloor':9} no idle samples in the window")
    else:
        out.append(f"{'idlefloor':9} median {floor['median']:.1f}C over "
                   f"{floor['samples']} idle samples (limit {floor['limit']:.0f}C)")
    out.append("")

    for subject, stat in data["drive_temps"].items():
        bounds = data["drive_limits"].get(subject, {})
        warn = bounds.get("max")
        tail = f"  (warn {warn:.0f}C)" if warn else ""
        out.append(f"drive  {subject:45} min {stat['min']:5.1f}  "
                   f"median {stat['median']:5.1f}  max {stat['max']:5.1f}{tail}")

    for path, usage in data["disks"].items():
        delta = usage["pct_end"] - usage["pct_start"]
        free = usage["free_gb_end"]
        free_text = f"  {free:.1f}G free" if free is not None else ""
        out.append(f"disk   {path:45} {usage['pct_start']:.2f}% -> "
                   f"{usage['pct_end']:.2f}%  ({delta:+.2f}){free_text}")

    if data["smart"]:
        out.append("")
        for dev, drive in data["smart"].items():
            parts = "  ".join(
                f"{c} {drive[c]['end']} ({drive[c]['delta']:+})"
                for c in ("percentage_used", "media_errors", "unsafe_shutdowns")
            )
            out.append(f"smart  {drive['model']}: {drive['health']}  {parts}")

    out.append("")
    if data["alerts"]:
        for entry in data["alerts"]:
            mark = "FIRE" if entry["kind"] == "fire" else "CLEAR"
            out.append(f"alert  {_clock(entry['ts'])}  {mark:5} [{entry['severity']}] "
                       f"{entry['title']}: {entry['body']}")
    else:
        out.append("alert  nothing logged in the window")
    return "\n".join(out)


def cmd_report(args: argparse.Namespace) -> int:
    data = report_data(args.hours)
    print(json.dumps(data, indent=2) if args.json else render_report(data))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="vitals", description="watch the things that can take this desktop down"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    check = sub.add_parser("check", help="run every probe and alert on what is wrong")
    check.add_argument("--quiet", action="store_true",
                       help="evaluate and record, but send no notifications")
    check.set_defaults(func=cmd_check)

    sub.add_parser("status", help="print what everything reads right now"
                   ).set_defaults(func=cmd_status)
    sub.add_parser("probe", help="dump the raw readings as JSON"
                   ).set_defaults(func=cmd_probe)

    log = sub.add_parser("log", help="recent alerts")
    log.add_argument("-n", type=int, default=20, help="how many lines")
    log.set_defaults(func=cmd_log)

    report = sub.add_parser("report", help="summarise a window for the morning read")
    report.add_argument("--hours", type=float, default=24.0,
                        help="how far back to look (default 24)")
    report.add_argument("--json", action="store_true", help="machine readable")
    report.set_defaults(func=cmd_report)

    sub.add_parser("root-probe", help="write SMART facts (run as root)"
                   ).set_defaults(func=cmd_root_probe)

    args = parser.parse_args()
    load_config()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
