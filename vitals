#!/usr/bin/env python3
"""vitals - watch the things that can take this desktop down.

Runs as a user systemd timer once a minute. Everything it needs is readable
without root except NVMe SMART attributes, which a separate hourly root timer
drops into a JSON file for this script to read.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

# --- paths -------------------------------------------------------------------

XDG_STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))

STATE_DIR = XDG_STATE / "vitals"
SAMPLES = STATE_DIR / "samples.csv"
READINGS = STATE_DIR / "readings.csv"
SMART_LOG = STATE_DIR / "smart.jsonl"
ALERT_STATE = STATE_DIR / "alerts.json"
ALERT_LOG = STATE_DIR / "alerts.jsonl"
CURSOR = STATE_DIR / "journal.cursor"
REPORT_CURSOR = STATE_DIR / "report.cursor"
CONFIG_FILE = XDG_CONFIG / "vitals/config.toml"

ROOT_FACTS = Path("/var/lib/vitals/root.json")

# --- config ------------------------------------------------------------------
# Baselines measured 2026-09-12 on this machine and recorded in COS-183.
# Override any of these in ~/.config/vitals/config.toml.

CONFIG: dict = {
    # The AIO has no readable pump RPM, so a rising *idle* CPU floor is the
    # only early warning of a weakening pump. Baseline from 11 days of
    # minute samples (2026-09-12 to 09-23, COS-184): the daily median idle
    # Tccd2 sat between 36C and 45C, the overall median at 42.5C, and 99% of
    # idle samples under 57C. A median that reaches 58C has moved 14C off
    # that floor, which a warm room does not do and a weakening pump does.
    # The load cut barely moves the number (41.8C at <=0.3, 42.5C at <=1.0)
    # and 1.0 keeps 87% of samples, so it stays.
    "idle_load_max": 1.0,          # load1 below this counts as idle
    "idle_window_hours": 24,
    "idle_min_samples": 30,        # don't judge the floor on thin data
    "idle_floor_warn": 58.0,       # median idle Tccd2 above this = alert
    # 5900X Tjmax is 90C and it boosts into it on purpose. Only a sustained
    # sit at the ceiling means something is wrong with the cooling.
    "cpu_tctl_crit": 89.0,

    # Both chips are designed to run at their limit under load, so these sit
    # just below the hardware's own numbers and only count when sustained.
    # RTX 3080: max operating 93C, slowdown 95C, shutdown 98C.
    "gpu_temp_warn": 88.0,
    "gpu_temp_crit": 92.0,
    # Core temperature does not predict fan state on this card: the samples
    # caught it restarting the fan at 42C after four hours off, then sitting
    # at 51-52C for nine hours with the fan legitimately stopped. The fan
    # curve reads the GDDR6X junction, which nvidia-smi will not report on a
    # consumer card. Power draw does separate the cases (COS-197): in 11 days
