    "gpu_fan_stall_power": 60.0,   # 0% fan while drawing this much = fan failure
    "gpu_fan_stall_temp": 70.0,    # ...or while this warm, whatever the draw
    "gpu_fan_confirm_minutes": 2,  # ...and still so this long later
    "sustained_minutes": 5,        # a gaming session is not an emergency

